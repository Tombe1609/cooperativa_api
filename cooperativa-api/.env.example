# Copie este archivo como ".env" y ajuste los valores (el archivo .env NO se sube a GitHub).

# Puerto de la API
PORT=3000

# Conexión a MongoDB (use 127.0.0.1 en lugar de "localhost" en Windows).
# MongoDB local sin replica set:
MONGODB_URI=mongodb://127.0.0.1:27017
# MongoDB local como replica set (habilita transacciones reales):
# MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# MongoDB Atlas (reemplace usuario, clave y cluster; nunca publique estos datos):
# MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/

DB_NAME=cooperativa_universitaria

# development muestra el detalle de errores internos; production lo oculta
NODE_ENV=development

# Monto máximo por préstamo (regla de ejemplo del TXT: 5.000.000)
LIMITE_PRESTAMO=5000000
